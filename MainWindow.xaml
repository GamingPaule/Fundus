<Window x:Class="Fundus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fundus" Width="1320" Height="800" MinWidth="760" MinHeight="420"
        Background="{StaticResource BgTitle}" Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="Assets/fundus.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="46" />
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ===== Titelleiste mit Tabs ===== -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" />
                <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" />
            </StackPanel>
            <Image DockPanel.Dock="Left" Source="Assets/logo.png" Width="20" Height="20" Margin="14,0,4,0"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" ToolTip="Fundus" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Style="{StaticResource ToolButton}" Content="&#xE710;" FontSize="12" ToolTip="Neuer Tab (Strg+T)"
                        Margin="4,0,0,5" Click="NewTab_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Navigation + Adressleiste ===== -->
        <Border Grid.Row="1" Background="{StaticResource BgToolbar}">
            <DockPanel Margin="8,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackBtn" Style="{StaticResource ToolButton}" Content="&#xE72B;" ToolTip="Zurück (Alt+←)" Click="Back_Click" />
                    <Button x:Name="FwdBtn" Style="{StaticResource ToolButton}" Content="&#xE72A;" ToolTip="Vor (Alt+→)" Click="Forward_Click" />
                    <Button x:Name="UpBtn" Style="{StaticResource ToolButton}" Content="&#xE74A;" ToolTip="Übergeordneter Ordner (Alt+↑)" Click="Up_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE72C;" ToolTip="Aktualisieren (F5)" Click="Refresh_Click" />
                </StackPanel>
                <Grid DockPanel.Dock="Right" Width="260" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Height="30" Padding="30,4,8,4"
                             KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" />
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                               Margin="10,0" VerticalAlignment="Center" Opacity="0.6" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchHint" Text="Suchen in …" Foreground="{StaticResource FgDim}"
                               Margin="30,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                </Grid>
                <!-- Adressfeld: Brotkrumen, Klick in freie Fläche = Pfad eintippen -->
                <Border x:Name="AddressFrame" Background="#38383C" CornerRadius="5" Height="30" Margin="6,0,0,0"
                        MouseLeftButtonDown="AddressFrame_Click" Cursor="IBeam">
                    <Grid>
                        <DockPanel x:Name="CrumbPanel" Margin="4,0">
                            <Image x:Name="AddressIcon" Width="16" Height="16" Margin="4,0,4,0" DockPanel.Dock="Left" />
                            <ScrollViewer x:Name="CrumbScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Cursor="Arrow">
                                <StackPanel x:Name="PathBar" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            </ScrollViewer>
                        </DockPanel>
                        <TextBox x:Name="AddressBox" Visibility="Collapsed" Style="{StaticResource SearchBox}" Background="#38383C"
                                 KeyDown="AddressBox_KeyDown" LostKeyboardFocus="AddressBox_LostFocus" />
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- ===== Befehlsleiste ===== -->
        <Border Grid.Row="2" Background="{StaticResource BgToolbar}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1">
            <StackPanel x:Name="CommandBar" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center" />
        </Border>

        <!-- ===== Inhalt ===== -->
        <Grid Grid.Row="3" Background="{StaticResource BgWindow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="140" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Background="{StaticResource BgSidebar}" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Sidebar" Margin="0,6,0,10" />
            </ScrollViewer>
            <GridSplitter Grid.Column="1" Width="4" Margin="-2,0" HorizontalAlignment="Stretch"
                          Background="{StaticResource Line}" ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2">
                <ScrollViewer x:Name="ColumnsScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ColumnsHost" Orientation="Horizontal" />
                </ScrollViewer>
                <Border x:Name="SingleHost" Visibility="Collapsed" />
                <ListBox x:Name="SearchResults" Visibility="Collapsed" Style="{StaticResource PlainList}"
                         Background="{StaticResource BgColumn}" MouseDoubleClick="SearchResults_DoubleClick"
                         KeyDown="SearchResults_KeyDown" ItemTemplate="{StaticResource SearchRow}" />
            </Grid>
        </Grid>

        <!-- ===== Statusleiste ===== -->
        <Border Grid.Row="4" Background="{StaticResource BgToolbar}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,0,6,0">
                <StackPanel x:Name="ViewSwitch" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource FgDim}" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ===== Quick Look ===== -->
        <Grid x:Name="QuickLook" Grid.RowSpan="5" Visibility="Collapsed" Background="#CC000000"
              MouseLeftButtonDown="QuickLook_Click">
            <Border x:Name="QuickLookCard" Background="#2B2B2E" CornerRadius="10" Margin="80,60"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <DockPanel>
                    <TextBlock x:Name="QuickLookTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="14,10"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ContentControl x:Name="QuickLookBody" Margin="14,0,14,14" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
